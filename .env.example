NEO4J_USER=neo4j
NEO4J_PASSWORD=choose-8-plus-chars
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kgrag

# SEC requires "Your Name your@email.com" on every request
SEC_USER_AGENT=
